#!/usr/bin/env bash
# Start the resume script once the Rex server answers. Rex runs this from
# init.lua while the server starts, before it accepts connections.
set -euo pipefail

state="${XDG_STATE_HOME:-$HOME/.local/state}/pi-rex"
mkdir -p "$state"
# Rex discards the output of its init commands; keep a log.
exec >>"$state/log" 2>&1

if ! command -v rex >/dev/null; then
  PATH="$PATH:/Applications/Rex Beta.app/Contents/Helpers/Rex Server.rex/Contents/MacOS"
fi

for _ in $(seq 60); do
  if rex --autostart=false server status >/dev/null 2>&1; then
    exec rex --autostart=false "do" "$(dirname "$0")/rex-resume.lua"
  fi
  sleep 1
done
