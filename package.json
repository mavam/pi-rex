{
  "name": "pi-rex",
  "version": "0.1.0",
  "description": "Reopen Pi conversations in Rex terminal blocks after the server restarts",
  "type": "module",
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "rex",
    "terminal",
    "multiplexer",
    "resume"
  ],
  "author": "Matthias Vallentin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mavam/pi-rex.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit && node --test --experimental-strip-types test/*.test.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
